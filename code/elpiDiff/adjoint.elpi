% adjoint.elpi — reverse mode: the transposition, into the derivative IR.
%
% The adjoint of `let x = e in body` is the adjoint of body followed by the
% adjoint of e: x_bar, accumulated by every use of x, flows to the operands of
% e through the partial derivatives. The reverse order is the recursion coming
% back. Guided by tbr.elpi, the forward sweep computes only the values the
% reverse sweep reads and records the state of a fold only when it is read;
% inside a reverse loop or branch, the values that are read are recomputed
% (replayed) instead of recorded.

shorten adjudge.{ argument, written, sweep, forward, replay, needs, records, state-live, atom-member, with-arguments, type-of, varied-value, stored, with-storage, open-let, open-fold, open-index, spell, spell-partial, bar, scale, sbind, sflatten, partial1, partial2, of }.

typeabbrev sweeps (pair (list dstmt) (list dstmt)).     % the forward sweep and the reverse sweep

namespace adjudge {

func recorded dvar.    % an array updated in place whose fold records it, on its tape

% The generated signature: the arguments of the primal, then the adjoint of
% each argument that has one, then the adjoint of a returned value.
%   independent  x_bar is accumulated: the caller initializes it;
%   dependent    y is not touched; y_bar is the seed, read only;
%   inout        the primal value is a working copy, by value; its adjoint is
%                transformed in place: on entry the adjoint of the final value,
%                on exit the adjoint of the initial value.
func adjoint afunction -> dfunction.
adjoint (a-function Name Def) (dfunction AName Body) :-
  AName is Name ^ "_adjoint",
  with-arguments Def adjoint-body Body.

func adjoint-body list (pair decl dvar), aresult, anf -> scoped dbody.
adjoint-body Args Res B R :-
  std.map Args adjoint-primal Ps, std.map Args adjoint-bar Bss, std.flatten Bss Bs,
  adjoint-seed Res Extra Prologue Seed,
  adj forward B Seed FR,
  std.flatten [Ps, Bs, Extra] Params,
  sbind FR (adjoint-finish Params Prologue) R.

func adjoint-finish list dparam, list dstmt, sweeps -> scoped dbody.
adjoint-finish Params Prologue (pr Fwd Rev) (done (dbody d-void Params Stmts)) :-
  std.flatten [Fwd, Prologue, Rev] Stmts.

% The seed, the adjoint of the result: an argument for a returned value; the
% adjoint of the written real, read then reset when that real is also an input;
% none for an array, whose adjoint is read element by element.
func adjoint-seed aresult -> list dparam, list dstmt, dexpr.
adjoint-seed (a-returns _) [dparam by-value real (bar-of result-var)] [] (d-var (bar-of result-var)) :- !.
adjoint-seed (a-writes Y) [] [] (d-var (bar-of X)) :- of Y real, argument Y _ dependent, !, stored Y X.
adjoint-seed (a-writes Y) []
  [d-define (d-constant real) (bar-of result-var) (d-var (bar-of X)), d-assign (d-var (bar-of X)) (d-real "0")]
  (d-var (bar-of result-var)) :-
  of Y real, argument Y _ inout, !, stored Y X.
adjoint-seed _ [] [] (d-real "0").

func adjoint-primal pair decl dvar -> dparam.
adjoint-primal (pr (decl _ integer _) V) (dparam by-value integer V) :- !.
adjoint-primal (pr (decl _ T dependent) V) (dparam by-ref-unused T V) :- !.
adjoint-primal (pr (decl _ real _) V) (dparam by-value real V) :- !.
adjoint-primal (pr (decl _ T inout) V) (dparam by-value T V) :- !.
adjoint-primal (pr (decl _ T _) V) (dparam by-cref T V).

func adjoint-bar pair decl dvar -> list dparam.
adjoint-bar (pr (decl _ integer _) _) [] :- !.
adjoint-bar (pr (decl _ _ passive) _) [] :- !.
adjoint-bar (pr (decl _ real dependent) V) [dparam by-value real (bar-of V)] :- !.
adjoint-bar (pr (decl _ real _) V) [dparam by-ref real (bar-of V)] :- !.
adjoint-bar (pr (decl _ T dependent) V) [dparam by-cref T (bar-of V)] :- !.
adjoint-bar (pr (decl _ T _) V) [dparam by-ref T (bar-of V)].

% adj M T Seed R: R holds the forward sweep, computing what the reverse sweep of
% T needs, and the reverse sweep, propagating Seed, the adjoint of T's value,
% back to the atoms of T. At each let, the body's needs (tbr.elpi) decide whether
% the binder is useful, hence active, and whether its value is needed, hence
% computed forward.
func adj sweep, anf, dexpr -> scoped sweeps.
adj M (a-let E B) Seed R :- !,
  type-of E T, if (varied-value E) (V = tt) (V = ff),
  with-storage E B (adj-let M E B T V Seed) R.
adj _ (a-ret X) Seed (done (pr [] Rev)) :- if (of X real, bar X BX) (Rev = [d-increment BX Seed]) (Rev = []).

func adj-let sweep, value, (atom -> anf), ty, bool, dexpr, dvar -> scoped sweeps.
adj-let M E B T V Seed N R :-
  open-let T N V (x\ adj M (B x) Seed SB,
                     needs M (B x) (U x) (L x),
                     if (atom-member x (U x)) (Useful = tt) (Useful = ff),
                     if (atom-member x (L x)) (Needed = tt) (Needed = ff)),
  if (V = tt, Useful = tt) (A = tt) (A = ff),
  if (Needed = tt ; M = forward, records E) (fwd-value M E T N FwdE) (FwdE = done []),
  if (A = tt) (bar-declaration T N Decl, rev-value E T N RevE) (Decl = [], RevE = done []),
  sbind SB (adj-let-fwd FwdE RevE Decl) R.

func adj-let-fwd code, code, list dstmt, sweeps -> scoped sweeps.
adj-let-fwd FwdE RevE Decl B R :- sbind FwdE (adj-let-rev RevE Decl B) R.

func adj-let-rev code, list dstmt, sweeps, list dstmt -> scoped sweeps.
adj-let-rev RevE Decl B FwdE R :- sbind RevE (adj-let-done Decl B FwdE) R.

func adj-let-done list dstmt, sweeps, list dstmt, list dstmt -> scoped sweeps.
adj-let-done Decl (pr FwdB RevB) FwdE RevE (done (pr Fwd Rev)) :-
  std.append FwdE FwdB Fwd,
  std.flatten [Decl, RevB, RevE] Rev.

func bar-declaration ty, dvar -> list dstmt.
bar-declaration real N [d-define d-mutable (bar-of N) (d-real "0")] :- !.
bar-declaration _ _ [].

% prim M T R: the primal computation of T, recording when M is forward, with the value of its tail atom.
func prim sweep, anf -> scoped (pair (list dstmt) dexpr).
prim M (a-let E B) R :- !,
  type-of E T, if (varied-value E) (Vr = tt) (Vr = ff),
  with-storage E B (prim-let M E B T Vr) R.
prim _ (a-ret X) (done (pr [] V)) :- spell X V.

func prim-let sweep, value, (atom -> anf), ty, bool, dvar -> scoped (pair (list dstmt) dexpr).
prim-let M E B T Vr N R :-
  fwd-value M E T N SE,
  open-let T N Vr (x\ prim M (B x) SB),
  sbind SE (prim-prepend SB) R.

func prim-prepend scoped (pair (list dstmt) dexpr), list dstmt -> scoped (pair (list dstmt) dexpr).
prim-prepend SB SE R :- sbind SB (prim-prepend-done SE) R.

func prim-prepend-done list dstmt, pair (list dstmt) dexpr -> scoped (pair (list dstmt) dexpr).
prim-prepend-done SE (pr SB V) (done (pr S V)) :- std.append SE SB S.

% fwd-value M E T N S: S computes the value E into N.
func fwd-value sweep, value, ty, dvar -> code.
fwd-value _ (a-op1 F A) T N (done [d-define (d-constant T) N (d-op1 F EA)]) :- !, spell A EA.
fwd-value _ (a-op2 F A B) T N (done [d-define (d-constant T) N (d-op2 F EA EB)]) :- !, spell A EA, spell B EB.
fwd-value _ (a-get A I) _ N (done [d-define (d-constant real) N (d-at EA EI)]) :- !, spell A EA, spell I EI.
fwd-value M (a-set _ I V) _ N (done S) :- !,
  spell I EI, spell V EV, Elem = d-at (d-var N) EI,
  if (M = forward, recorded N) (S = [d-push (tape-of N) Elem, d-assign Elem EV]) (S = [d-assign Elem EV]).
fwd-value M (a-ite C Then Else) _ N R :- !,
  spell C EC, prim M Then ST, prim M Else SE,
  sbind ST (fwd-ite-then SE EC N) R.
fwd-value M (a-map Lo Hi B) _ N (fresh "i" R) :- !,
  spell Lo ELo, spell Hi EHi,
  pi i\ open-index i (x\ prim M (B x) (SB i)), sbind (SB i) (fwd-map i ELo EHi N) (R i).
fwd-value M (a-fold Lo Hi Init B) real N (fresh "i" R) :- !,
  spell Lo ELo, spell Hi EHi, spell Init EI,
  if (M = forward, state-live Init B) (Live = tt) (Live = ff),
  pi i\ open-fold Init B real N i (x\ s\ prim M (B x s) (SB i)), sbind (SB i) (fwd-fold i ELo EHi EI Live N) (R i).
fwd-value M (a-fold Lo Hi Init B) (array K) N (fresh "i" R) :-
  spell Lo ELo, spell Hi EHi,
  if (M = forward, state-live Init B)
     (recorded N =!=> pi i\ open-fold Init B (array K) N i (x\ s\ prim M (B x s) (SB i)))
     (pi i\ open-fold Init B (array K) N i (x\ s\ prim M (B x s) (SB i))),
  if (M = forward, written Init, records (a-fold Lo Hi Init B)) (Decl = [d-tape (tape-of N)]) (Decl = []),
  pi i\ sbind (SB i) (fwd-fold-array i ELo EHi Decl) (R i).

func fwd-ite-then scoped (pair (list dstmt) dexpr), dexpr, dvar, pair (list dstmt) dexpr -> code.
fwd-ite-then SE EC N BT R :- sbind SE (fwd-ite EC N BT) R.

func fwd-ite dexpr, dvar, pair (list dstmt) dexpr, pair (list dstmt) dexpr -> code.
fwd-ite EC N (pr ST VT) (pr SE VE) (done [d-real-var N, d-branch EC BT BE]) :-
  std.append ST [d-assign (d-var N) VT] BT,
  std.append SE [d-assign (d-var N) VE] BE.

func fwd-map dvar, dexpr, dexpr, dvar, pair (list dstmt) dexpr -> code.
fwd-map I ELo EHi N (pr SB VB) (done [d-for I ELo EHi Body]) :-
  std.append SB [d-assign (d-at (d-var N) (d-var I)) VB] Body.

func fwd-fold dvar, dexpr, dexpr, dexpr, bool, dvar, pair (list dstmt) dexpr -> code.
fwd-fold I ELo EHi EI tt N (pr SB VB) (done [d-define d-mutable N EI, d-tape (tape-of N), d-for I ELo EHi Body]) :- !,
  std.flatten [[d-push (tape-of N) (d-var N)], SB, [d-assign (d-var N) VB]] Body.
fwd-fold I ELo EHi EI ff N (pr SB VB) (done [d-define d-mutable N EI, d-for I ELo EHi Body]) :-
  std.append SB [d-assign (d-var N) VB] Body.

func fwd-fold-array dvar, dexpr, dexpr, list dstmt, pair (list dstmt) dexpr -> code.
fwd-fold-array I ELo EHi Decl (pr SB _) (done S) :- std.append Decl [d-for I ELo EHi SB] S.

% rev-value E T N S: S propagates the adjoint of N, the value of E, to the atoms of E.
func rev-value value, ty, dvar -> code.
rev-value (a-op1 F A) _ N (done S) :- !, partial1 F A P, contribution A P (bar-of N) S.
rev-value (a-op2 F A B) _ N (done S) :- !,
  partial2 F A B PA PB,
  contribution A PA (bar-of N) SA, contribution B PB (bar-of N) SB, std.append SA SB S.
rev-value (a-get A I) _ N (done [d-increment (d-at BA EI) (d-var (bar-of N))]) :- !, bar A BA, spell I EI.
rev-value (a-set _ I V) _ N (done S) :- !,
  spell I EI, Elem = d-at (d-var (bar-of N)) EI,
  if (bar V BV) (S = [d-increment BV Elem, d-assign Elem (d-real "0")]) (S = [d-assign Elem (d-real "0")]).
rev-value (a-ite C Then Else) _ N R :- !,
  spell C EC,
  adj replay Then (d-var (bar-of N)) ST,
  adj replay Else (d-var (bar-of N)) SE,
  sbind ST (rev-ite-then SE EC) R.
rev-value (a-map Lo Hi Body) _ N (fresh "i" R) :- !,
  spell Lo ELo, spell Hi EHi,
  pi i\ open-index i (x\ adj replay (Body x) (d-at (d-var (bar-of N)) (d-var i)) (SB i)),
        sbind (SB i) (rev-loop i ELo EHi [] []) (R i).
rev-value (a-fold Lo Hi Init Body) real N (fresh "i" R) :- !,
  spell Lo ELo, spell Hi EHi,
  if (state-live Init Body) (Pop = [d-pop (tape-of N) (d-var N)]) (Pop = []),
  if (bar Init BI) (After = [d-increment BI (d-var (bar-of N))]) (After = []),
  pi i\ R i = fresh "r" (R' i), pi r\
    open-fold Init Body real N i (x\ s\ adj replay (Body x s) (d-var (bar-of r)) (SB i r)),
    sbind (SB i r) (rev-loop i ELo EHi Pop [d-define (d-constant real) (bar-of r) (d-var (bar-of N)),
                                                d-assign (d-var (bar-of N)) (d-real "0")]) (L i r),
    sbind (L i r) (rev-after After) (R' i r).
rev-value (a-fold Lo Hi Init Body) (array K) N (fresh "i" R) :-
  spell Lo ELo, spell Hi EHi,
  pi i\ open-fold Init Body (array K) N i (x\ s\ adj replay (Body x s) (d-real "0") (SB i),
                                                if (state-live Init Body) (tail-index (Body x s) (Ix i)) (Ix i = d-int 0)),
        if (state-live Init Body) (Pop i = [d-pop (tape-of N) (d-at (d-var N) (Ix i))]) (Pop i = []),
        sbind (SB i) (rev-loop i ELo EHi (Pop i) []) (R i).

func rev-ite-then scoped sweeps, dexpr, sweeps -> code.
rev-ite-then SE EC BT R :- sbind SE (rev-ite EC BT) R.

func rev-ite dexpr, sweeps, sweeps -> code.
rev-ite EC (pr FT RT) (pr FE RE) (done [d-branch EC BT BE]) :- std.append FT RT BT, std.append FE RE BE.

% rev-loop I Lo Hi Pop Mid S: the reverse loop: restore, replay, then propagate.
func rev-loop dvar, dexpr, dexpr, list dstmt, list dstmt, sweeps -> code.
rev-loop I ELo EHi Pop Mid (pr F Rv) (done [d-for-back I ELo EHi Stmts]) :- std.flatten [Pop, F, Mid, Rv] Stmts.

func rev-after list dstmt, list dstmt -> code.
rev-after After L (done S) :- std.append L After S.

% contribution A P X S: `A_bar += P * X`, when the operand A carries an adjoint.
func contribution atom, pexpr, dvar -> list dstmt.
contribution A P X [d-increment BA E] :- bar A BA, !, spell-partial P EP, scale EP (d-var X) E.
contribution _ _ _ [].

% The index written by the update that ends the body of an in-place fold.
func tail-index anf -> dexpr.
tail-index (a-let (a-set _ I _) (x\ a-ret x)) E :- !, spell I E.
tail-index (a-let _ B) E :- pi x\ tail-index (B x) E.

}
