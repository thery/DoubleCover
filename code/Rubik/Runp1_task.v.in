(*  Runp1_@N@.v                                                              *)
(*                                                                            *)
(*  GENERATED by mkrunp1.sh -- do not edit.                                  *)
(*                                                                            *)
(*  One of the eighteen independent pieces of the phase 1 search: the second  *)
(*  move is fixed to @J@, at depth @DEPTH@, and both root moves are covered.  *)
(*  Exactly the decomposition Far_@N@.v uses, so the two are comparable.      *)
(* =========================================================================  *)

From mathcomp Require Import all_ssreflect all_fingroup.
From Stdlib Require Import Uint63.
From Stdlib Require Import -(notations) PArray.
From Rubik Require Import ssrint63.
Require Import Cyc Ball Table Search Tsearch Tabi Rubik333 Sym Root Coord
        Coordfs Coordfsi Fstab FsTable Diameter Moves
        Searchr Redun Searchir P1Small P1Ts P1Fs P1Fsm Phase1 Far Fsparity
        Farp1 P1Table Runp1 Fast FastP.

Set Implicit Arguments.
Unset Strict Implicit.
Unset Printing Implicit Defensive.

Import GroupScope.

Lemma p1searchd_@N@ :
  all (fun i => ~~ searchz3 p1tab @D@ (prefixi i @J@)
                            (init3 (prefixi i @J@)) nfcube)
      (iota 0 nroot).
(* the evaluator is chosen by mkrunp1.sh: EVAL=vm (default) or EVAL=native.
   Far_??.v goes native because fstab is two million words; whether that is
   still right for a 4.5 GB table is a question for measurement, not for me
   to assert -- generate both and time them. *)
(* RUN WITH THE FAST SEARCH.  searchz3n is searchz3 with the strictness
   waste removed -- MEASURED at 11.1x on one piece at depth 14 -- and
   Fast.searchz3nE is the bridge, which is ADMITTED.  So this lemma is
   proved, but the admit rides along: Print Assumptions will show it. *)
Proof.
have hE :
  (fun i => ~~ searchz3 p1tab @D@ (prefixi i @J@)
                        (init3 (prefixi i @J@)) nfcube)
  =1
  (fun i => ~~ searchz3n p1tab @D@ @D@%uint63 (prefixi i @J@) [::]
                         (init3 (prefixi i @J@)) nfcube).
  by move=> i; rewrite searchz3nE.
rewrite (eq_all hE).
Time @CAST@_cast_no_check (erefl true).
Qed.
