## =========================================================================
##  Makefile.local -- picked up by the coq_makefile Makefile (its line 52).
##
##  THE JOB COUNT FOR THE BIG TARGETS IS A MEMORY QUESTION, NOT A CPU ONE.
##
##  A P1Chk slice and a Runp1 search each materialise the phase 1 table, and
##  launching more of them than the RAM holds does not run slowly, it stops
##  running.  MEASURED on the 64 GB machine, 2026-08-05: twenty seven slices
##  at once filled the swap and gave 68.5 % iowait against 0.1 % user -- no
##  computation at all was happening, and it took several minutes of killing
##  to get back.
##
##  So do NOT say `make -j18 P1ChkAll.vo'.  Say, with no -j at all,
##
##      make p1run        the eighteen depth searches
##      make p1jobs       just print what those two would use, and why
##
##  and the concurrency is computed from the RAM actually present.  Override
##  a figure on the command line if a run tells you otherwise:
##
## =========================================================================

# ---- what a job costs, in GB ---------------------------------------------
# MEASURED with ./watchmem.sh: a search piece is 4.15 GB and a certificate
# slice 3.0 GB, both flat for the whole run and both independent of the
# depth.  6 GB is those with room to spare, and on a 62 GB machine it gives
# -j9 -- which also divides the 18 pieces and the 27 slices evenly.
P1RUN_GB    ?= 6

# Left for the kernel, the page cache and whatever else is on the machine.
# The .vo files being written are large and the cache earns its keep.
P1_RESERVE_GB ?= 8

P1_MEMGB := $(shell awk '/MemTotal/ {printf "%d", $$2 / 1048576}' /proc/meminfo)
P1_NCPU  := $(shell nproc)

# min(cpus, (RAM - reserve) / cost), and at least one.
p1_jobs = $(shell n=$$(( ($(P1_MEMGB) - $(P1_RESERVE_GB)) / $(1) )); \
                  [ $$n -gt $(P1_NCPU) ] && n=$(P1_NCPU); \
                  [ $$n -lt 1 ] && n=1; echo $$n)

P1RUN_J := $(call p1_jobs,$(P1RUN_GB))

# One build has both kinds of job in it at once, so its concurrency comes
# from whichever is the larger.
P1_GB := $(P1RUN_GB)
P1_J  := $(call p1_jobs,$(P1_GB))

# and a plain `make Farp1inst.vo' gets it too: it has 27 slices and 18
# searches to build, which one at a time is a day.  A -j on the command line
# still wins.
ifeq (,$(filter -j%,$(MAKEFLAGS)))
MAKEFLAGS += -j$(P1_J)
endif

# ---- the targets ---------------------------------------------------------
P1RUN_VO := $(patsubst %.v,%.vo,$(sort $(wildcard Runp1_[0-9]*.v)))

# One command builds the whole phase 1 result at a chosen depth:
#
#     DEPTH=16 make test        a short run, to check the chain end to end
#     DEPTH=19 make test        the real one
#
# It regenerates the eighteen searches, raises the stack the native pass
# needs, and builds Farp1inst.vo -- the certificate slices and the searches
# in one graph, so make overlaps them -- at the job count the RAM allows.
# Everything already on disk is kept, so an interrupted run continues where
# it stopped.
#
# The folded table and its certificate are not in _CoqProject -- they need
# P1Fold.v, which does not exist until ./mkfold.sh has emitted it, and
# coqdep would refuse the whole project.  So make cannot build FoldAtTable.vo
# and `test' calls ./mkfold.sh when it is missing.
DEPTH ?= 16

.PHONY: p1run p1jobs test fold timed

# NO PREREQUISITES.  FoldTables.v requires P1Fold, which does not exist until
# mkfold.sh has emitted it, so make cannot build any of the in-project fold
# files first -- it stops with "Unable to locate library P1Fold".  The script
# builds them itself, in the middle, once the tables are there.
fold:
	./mkfold.sh $(P1_J) 2

# Diam20.v is out of _CoqProject: it holds a guard `p1depth = 19', so it is
# meaningless -- and fails -- at any other depth.  At 19 it is the theorem
# thery actually wants, `~~ diam_le Sset 19', with nothing admitted, and it
# costs seconds since the searches are already .vo by then.
test: fold
	./mkrunp1.sh $(DEPTH)
	ulimit -s unlimited; $(MAKE) -j$(P1_J) Farp1inst.vo
	@if [ "$(DEPTH)" = "19" ]; then \
	   echo "== depth 19: God's number is at least 20"; \
	   ulimit -s unlimited; rocq compile -R . Rubik Diam20.v; \
	 fi

# The same run, with a time for every file:
#
#     DEPTH=16 make timed
#
# `pretty-timed' is coq_makefile's own: it builds the target with TIMED=1,
# which times each file, and writes the table sorted by cost to
# time-of-build-pretty.log.  IT ONLY TIMES WHAT IT ACTUALLY BUILDS, so on a
# finished tree the table is empty -- start from a clean one, or from the
# state a fresh checkout is in.
#
# The fold's files are out of _CoqProject and coq_makefile cannot see them.
# They time themselves through ./rocqtime.sh, into fold-timing.log.
#
# TIMED_J is separate from the build's job count on purpose: a per file time
# taken with nine of them competing for memory bandwidth is not the file's
# cost.  Three is the honest number, and the run is longer for it.
#
# TIMED_TGTS=all covers everything in _CoqProject.  Farp1inst.vo, which is
# most of it -- the eighteen searches, the three checks, P1TsChk -- leaves
# out the sixteen Fs_?? slices, Fsmain, Fast, FastP and Toy.
TIMED_J    ?= 3
TIMED_TGTS ?= all

# THE ORDER IS THE WHOLE POINT.  The emitted tables first, because nothing
# in _CoqProject builds without them; then the project under the timer,
# which is where P1Fsm.vo and its 25 GB ocamlopt are; then the fold's own
# certificates.  Letting mkfold.sh run whole first would build P1Fsm.vo
# itself, through FoldChecks -> Farp1, and the table would not have it.
timed:
	./mkrunp1.sh $(DEPTH)
	PHASE=tables ./mkfold.sh $(P1_J) 2
	ulimit -s unlimited; $(MAKE) -j$(TIMED_J) pretty-timed TGTS="$(TIMED_TGTS)"
	./mkfold.sh $(P1_J) 2
	@echo "the in-project files: time-of-build-pretty.log"
	@echo "the fold's:           fold-timing.log"

p1jobs:
	@echo "$(P1_MEMGB) GB of RAM, $(P1_NCPU) cpus, $(P1_RESERVE_GB) GB reserved"
	@echo "  p1run: $(words $(P1RUN_VO)) searches at $(P1RUN_GB) GB -> -j$(P1RUN_J)"
	@echo "  test:  depth $(DEPTH), the fold then the searches -> -j$(P1_J)"

p1run:
	@[ -n "$(P1RUN_VO)" ] || { echo "no Runp1_NN.v -- run ./mkrunp1.sh first" >&2; exit 1; }
	@echo "== $(words $(P1RUN_VO)) searches, $(P1RUN_GB) GB each, $(P1_MEMGB) GB RAM -> -j$(P1RUN_J)"
	$(MAKE) -j$(P1RUN_J) $(P1RUN_VO)

# ==========================================================================
#  THE QUARTER TURN BOUND, END TO END
#
#      make htest                     the whole chain
#      make htest 2>&1 | tee h.log    the same, kept
#      make hjobs                     the job counts and where they come from
#
#  For a clean run, delete the artefacts first -- by hand, on purpose:
#
#      rm -f *.vo *.vos *.vok *.glob .*.aux && rm -rf .coq-native
#
#  Everything already built is kept, so an interrupted run continues where it
#  stopped.  The emitted .v files are kept too: they are data, and nothing in
#  the proof takes their content on trust.
#
#  THE PHASES ARE SEQUENTIAL ON PURPOSE.  Each has its own memory cost, and
#  two at once is what filled the swap on 18 August: the 29 GB flat table was
#  still in /dev/shm, which is RAM, while twelve workers held the folded one.
#  Phase 0 looks for it and refuses to start.
#
#  WHAT IT COSTS, measured on roquableu on 17/18 August 2026:
#    the tables and the 59 fold chunks   ~3 h 25 wall, the ocamlopt pass most
#    the search, 72 jobs                 4 h 00 wall / 45.9 CPU-h
#    the table sweep, 12 jobs            2 h 51 wall / 31.7 CPU-h
#    the three coordinate sweeps         80 CPU-s
#    HAll and Print Assumptions          about a minute
#  so one night.  The time of each piece lands in fold-timing.log.
# ==========================================================================

# MEASURED: a fold chunk is 8.8 GB, almost all of it the ocamlopt pass, and a
# worker holding the folded table is 3.86 GiB.  A C sweep holds the three
# move tables and nothing else, which is small -- 2 GB is a GUESS with room.
HFOLD_GB   ?= 9
HRUN_GB    ?= 4
HSWEEP_GB  ?= 4
HSWEEPC_GB ?= 2

HFOLD_J   := $(call p1_jobs,$(HFOLD_GB))
HRUN_J    := $(call p1_jobs,$(HRUN_GB))
HSWEEP_J  := $(call p1_jobs,$(HSWEEP_GB))
HSWEEPC_J := $(call p1_jobs,$(HSWEEPC_GB))

# the 120 prefixes are dealt into this many slices, for the search and for
# the sweep alike
HNJ ?= 12

.PHONY: htest hjobs

hjobs:
	@echo "$(P1_MEMGB) GB of RAM, $(P1_NCPU) cpus, $(P1_RESERVE_GB) GB reserved"
	@echo "  fold chunks: $(HFOLD_GB) GB each -> -j$(HFOLD_J)"
	@echo "  search:      $(HRUN_GB) GB each  -> -j$(HRUN_J)"
	@echo "  table sweep: $(HSWEEP_GB) GB each  -> -j$(HSWEEP_J)"
	@echo "  C sweeps:    $(HSWEEPC_GB) GB each  -> -j$(HSWEEPC_J)"

htest:
	@echo "== phase 0: is the RAM free"
	@if ls /dev/shm/*.tbl >/dev/null 2>&1; then \
	   echo "a table is in /dev/shm, which is RAM -- delete it first" >&2; \
	   ls -la /dev/shm/*.tbl >&2; exit 1; fi
	@if [ ! -f ocaml/h_fold14.tbl ]; then \
	   echo "ocaml/h_fold14.tbl is missing:" >&2; \
	   echo "  cd ocaml && make hbuild JOBS=18 && make hfold" >&2; \
	   exit 1; fi
	@date
	@echo "== phase 1: the small tables, and the chunks of the folded one"
	./mkhtbl.sh $(HFOLD_J) 2
	@echo "== phase 2: the development, up to the cut"
	ulimit -s unlimited; $(MAKE) -j$(P1_J) HCut.vo HPrefix.vo HFinal.vo
	@echo "== phase 3: the search, $(HRUN_J) workers"
	./mkhrun.sh $(HNJ)
	ulimit -s unlimited; ls HRun_*.v | sed 's/[.]v$$//' | \
	  xargs -P $(HRUN_J) -I{} ./rocqtime.sh {}
	@echo "== phase 4: obligation D, the sweep of the table"
	./mkhsweep.sh $(HNJ)
	ulimit -s unlimited; ls HSweep_[0-9]*.v | sed 's/[.]v$$//' | \
	  xargs -P $(HSWEEP_J) -I{} ./rocqtime.sh {}
	ulimit -s unlimited; ./rocqtime.sh HSweepAll
	@echo "== phase 5: obligation C, the three coordinate sweeps"
	./mkhsweepc.sh
	ulimit -s unlimited; ls HSweepE_*.v | sed 's/[.]v$$//' | \
	  xargs -P $(HSWEEPC_J) -I{} ./rocqtime.sh {}
	ulimit -s unlimited; ./rocqtime.sh HSweepCAll
	@echo "== phase 6: the theorem, and what it rests on"
	./mkhall.sh
	ulimit -s unlimited; ./rocqtime.sh HAll
	@printf 'From Rubik Require Import HAll.\nPrint Assumptions qdiam25.\n' > HPa.v
	ulimit -s unlimited; rocq compile -R . Rubik HPa.v
	@rm -f HPa.v HPa.vo HPa.glob HPa.vok HPa.vos .HPa.aux
	@echo "== it must name nothing but the int63 and array primitives"
	@date
