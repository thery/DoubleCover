% tbr.elpi — to-be-recorded: what the adjoint code needs, computed bottom-up.
%
% `needs M T U L` returns two sets of atoms for a body T transposed in sweep M:
%   U, the atoms the value of T depends on through positions that carry a
%      derivative (the backward half of activity analysis: useful);
%   L, the atoms the adjoint code of T references by value: read by a partial
%      derivative, an index, a condition or a loop bound, or needed to compute a
%      value that is.
% A binder is active when varied and useful; its value is computed by the
% forward sweep when it is in L, and, in the forward sweep, when a fold in it
% records. In A-normal form this is one structural pass: a partial derivative
% is a term over atoms, so what it reads is syntactic. Two decisions follow:
%   - a sweep computes a let, or replays it inside a reverse loop, only when
%     its binder is needed;
%   - a fold records its state before each overwrite only when the reverse
%     loop reads it (state-live).

shorten adjudge.{ varied, let-binder, fold-binders, comparison, partial1, partial2, atoms-of, atoms-of-list, atom-member, atom-remove, atom-union }.

namespace adjudge {

kind sweep type.
type forward sweep.                % the forward sweep of the adjoint: computes and records
type replay  sweep.                % a recomputation inside a reverse loop or branch: records nothing

func needs sweep, term -> list term, list term.
func value-needs term -> list term, list term.
func state-live term, (term -> term -> term).
func records term.
func records-in term.
func read-by term, term -> list term.

needs M (let E B) U L :- !,
  if (varied E) (V = tt) (V = ff),
  let-binder E (x\ needs M (B x) (UB x) (LB x),
                  if (atom-member x (UB x)) (Useful = tt) (Useful = ff),
                  if (atom-member x (LB x)) (Needed = tt) (Needed = ff),
                  atom-remove x (UB x) U0, atom-remove x (LB x) L0),
  if (V = tt, Useful = tt) (value-needs E ReadsE FlowsE) (ReadsE = [], FlowsE = []),
  if (Needed = tt ; M = forward, records E) (atoms-of E AtomsE) (AtomsE = []),
  atom-union U0 FlowsE U,
  atom-union L0 ReadsE L1, atom-union L1 AtomsE L.
needs _ X U [] :- atoms-of X U.       % the tail: the result is this atom; its reverse only touches its bar

% value-needs E R F: for an active value E, R the atoms its reverse reads, F the
% atoms its value depends on. Loop bodies and branches are always replayed.
value-needs (op1 F A) R Fl :- !, partial1 F A P, read-by A P R, atoms-of A Fl.
value-needs (op2 F _ _) [] [] :- comparison F, !.
value-needs (op2 F A B) R Fl :- !,
  partial2 F A B PA PB, read-by A PA RA, read-by B PB RB, atom-union RA RB R,
  atoms-of-list [A, B] Fl.
value-needs (get A I) R Fl :- !, atoms-of I R, atoms-of A Fl.
value-needs (set A I V) R Fl :- !, atoms-of I R, atoms-of-list [A, V] Fl.
value-needs (ite C T E) R Fl :- !,
  needs replay T UT LT, needs replay E UE LE,
  atoms-of C RC, atom-union RC LT R1, atom-union R1 LE R,
  atom-union UT UE Fl.
value-needs (map Lo Hi B) R Fl :- !,
  (pi i\ needs replay (B i) (U i) (L i), atom-remove i (U i) Fl, atom-remove i (L i) L0),
  atoms-of-list [Lo, Hi] RB, atom-union RB L0 R.
value-needs (fold Lo Hi Init B) R Fl :-
  fold-binders Init B (i\ s\ needs replay (B i s) (U i s) (L i s),
                          atom-remove i (U i s) (U1 s), atom-remove s (U1 s) U0,
                          atom-remove i (L i s) (L1 s), atom-remove s (L1 s) L0),
  atoms-of-list [Lo, Hi] RB, atom-union RB L0 R,
  atoms-of Init FI, atom-union FI U0 Fl.

% read-by A P R: R, the atoms the partial derivative P reads, when the operand A is varied.
read-by A P R :- varied A, !, atoms-of P R.
read-by _ _ [].

% The state of a fold is recorded before each overwrite iff the reverse loop reads it.
state-live Init B :- fold-binders Init B (i\ s\ needs replay (B i s) _ (L i s), atom-member s (L i s)).

% The forward sweep must run a let when a fold in it records something.
records (fold _ _ I B) :- state-live I B, !.
records (fold _ _ I B) :- !, fold-binders I B (i\ s\ records-in (B i s)).

records-in (let E _) :- records E, !.
records-in (let E B) :- let-binder E (y\ records-in (B y)).

}
