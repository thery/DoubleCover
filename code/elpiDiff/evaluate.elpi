% evaluate.elpi — running the functions of a case with the evaluators.
%
% Not accumulated by adjudge.elpi: the evaluators use float functions of Elpi
% newer than its release 3.7.1 (fexp, pow, string_to_real), and the tool itself
% must keep working without them. A case is evaluated through a file that
% accumulates this one and the case:
%   accumulate evaluate.  accumulate primal.
% then
%   elpi -I <elpiDiff> -I <case> that-file.elpi -exec run -- <function> <argument>..
% An argument is a real literal (0.7), an integer (3), or, for an array of N
% reals, N real literals in a row.

accumulate adjudge.
accumulate numbers.
accumulate eval.

shorten adjudge.{ floats, eval-function, read-arguments, val-string, signature-string, ty-string }.

% run [Name | Args]: prints the value of the function Name of the case on Args.
func run list string.
run [Name | Args] :- !,
  std.findall (primal (function Name _)) Ps,
  if (Ps = [primal (function Name D) | _])
     (floats Dom, read-arguments D Args Vs, eval-function Dom (function Name D) Vs V,
      val-string V S, print S)
     (M is "no function `" ^ Name ^ "` in the case", std.fatal-error M).
run _ :- std.fatal-error "usage: elpi -I <elpiDiff> -I <case> <file accumulating evaluate and the case> -exec run -- <function> <argument>..".

% signatures []: prints the signature of each function of the case, one per
% line: its name, its arguments as name:type:role, and its result.
func signatures list string.
signatures _ :-
  std.findall (primal _) Ps,
  std.forall Ps (p\ sigma F S\ p = primal F, signature-string F S, print S).

namespace adjudge {

func signature-string function -> string.
signature-string (function N D) S :- definition-strings D As R, std.string.concat " " [N | As] S0, S is S0 ^ " -> " ^ R.

func definition-strings definition -> list string, string.
definition-strings (body (returns T) _) [] R :- !, ty-string T TS, R is "returns " ^ TS.
definition-strings (body (writes Y) _) [] R :- !, if (arg-name Y N) (R is "writes " ^ N) (R = "writes ?").
definition-strings (arg N T Ro F) [A | As] R :-
  ty-string T TS, term_to_string Ro RS, A is N ^ ":" ^ TS ^ ":" ^ RS,
  pi x\ arg-name x N =!=> definition-strings (F x) As R.

func arg-name term -> string.

% read-arguments D Ss Vs: the values of the arguments of the definition D, read
% from the strings Ss according to their types.
func read-arguments definition, list string -> list (val float).
read-arguments (body _ _) [] [] :- !.
read-arguments (arg _ T _ F) Ss [V | Vs] :- !,
  read-argument T Ss V Rest, pi x\ read-arguments (F x) Rest Vs.
read-arguments _ _ _ :- std.fatal-error "the arguments do not match the declaration of the function".

func read-argument ty, list string -> val float, list string.
read-argument real [S | Ss] (v-real X) Ss :- !, X is string_to_real S.
read-argument integer [S | Ss] (v-int K) Ss :- !, K is string_to_int S.
read-argument (array N) Ss (v-array Xs) Rest :- std.take N Ss Ts, std.drop N Ss Rest, std.map Ts (s\ x\ x is string_to_real s) Xs.

func val-string val float -> string.
val-string (v-real X) S :- !, S is real_to_string X.
val-string (v-int K) S :- !, S is int_to_string K.
val-string (v-bool tt) "true" :- !.
val-string (v-bool ff) "false" :- !.
val-string (v-array Xs) S :- std.map Xs (x\ s\ s is real_to_string x) Ss, std.string.concat " " Ss S.

}
