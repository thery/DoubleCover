(*                                                                            *)
(*  One of the eighteen independent pieces of the depth 12 search: the second *)
(*  move is fixed to @J@, and both root moves are covered.  Far12main.v glues  *)
(*  the eighteen together.                                                    *)
(* =========================================================================  *)

From mathcomp Require Import all_ssreflect all_fingroup.
From Stdlib Require Import Uint63.
From Stdlib Require Import -(notations) PArray.
From Rubik Require Import Tabi Coordfsi Fstab FsTable Toy Far12.

Set Implicit Arguments.
Unset Strict Implicit.
Unset Printing Implicit Defensive.

Import GroupScope.

Lemma searchj_@N@ :
  all (fun i => ~~ searchi 47 mtis Dti12 droot (prefixi i @J@)) (iota 0 nroot).
(* native_cast_no_check, not "by vm_compute": the latter evaluates twice,
   once in the tactic and once when the kernel rechecks the cast at Qed.
   This evaluates once, and natively.  If the native compiler is not
   available, vm_cast_no_check (erefl true) is the fallback.               *)
Proof. Time native_cast_no_check (erefl true). Qed.
